{
  "name": "devine-ai-clone",
  "private": true,
  "packageManager": "bun@1.3.14",
  "workspaces": ["apps/*", "packages/*"],
  "scripts": {
    "dev": "turbo dev",
    "build": "turbo build",
    "db:generate": "bunx prisma generate --config packages/db/prisma.config.ts",
    "db:migrate": "bunx prisma migrate dev --config packages/db/prisma.config.ts",
    "db:push": "bunx prisma db push --config packages/db/prisma.config.ts",
    "db:validate": "bunx prisma validate --config packages/db/prisma.config.ts",
    "sandbox:build": "docker build -t devine-sandbox:latest ./docker/sandbox"
  },
  "devDependencies": {
    "turbo": "^2.10.9"
  },
  "dependencies": {
    "dotenv": "^17.4.2"
  }
}
