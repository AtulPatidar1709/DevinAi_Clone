{
  "name": "@devine/db",
  "private": true,
  "type": "module",
  "main": "./dist/index.js",
  "types": "./dist/index.d.ts",
  "exports": {
    ".": {
      "types": "./dist/index.d.ts",
      "import": "./dist/index.js"
    }
  },
  "scripts": {
    "generate": "prisma generate --config prisma.config.ts",
    "migrate": "prisma migrate dev --config prisma.config.ts",
    "push": "prisma db push --config prisma.config.ts",
    "validate": "prisma validate --config prisma.config.ts",
    "build": "prisma generate --config prisma.config.ts && tsc"
  },
  "dependencies": {
    "@prisma/adapter-pg": "^7.9.1",
    "@prisma/client": "^7.9.1",
    "pg": "^8.23.0"
  },
  "devDependencies": {
    "@types/pg": "^8.21.0",
    "dotenv": "^17.4.2",
    "prisma": "^7.9.1",
    "typescript": "^5.9.2"
  }
}
